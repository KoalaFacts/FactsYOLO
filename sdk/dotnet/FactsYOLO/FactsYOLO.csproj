<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <PackageId>FactsYOLO.LocalTest</PackageId>
    <Description>Local installation acceptance package for the experimental FactsYOLO ABI. Not a public release.</Description>
    <Authors>FactsYOLO contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/KoalaFacts/FactsYOLO</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <BuildOutputTargetFolder>lib</BuildOutputTargetFolder>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="../../../LICENSE;../../../NOTICE" Pack="true" PackagePath="/" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="$(NativeAssetsRoot)/linux-x64/libfacts_yolo.so" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(NativeAssetsRoot)/win-x64/facts_yolo.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(NativeAssetsRoot)/linux-x64/**/*" Exclude="$(NativeAssetsRoot)/linux-x64/**/*.dll;$(NativeAssetsRoot)/linux-x64/**/*.so" Pack="true" PackagePath="buildinfo/linux-x64/%(RecursiveDir)" />
    <None Include="$(NativeAssetsRoot)/win-x64/**/*" Exclude="$(NativeAssetsRoot)/win-x64/**/*.dll;$(NativeAssetsRoot)/win-x64/**/*.so" Pack="true" PackagePath="buildinfo/win-x64/%(RecursiveDir)" />
  </ItemGroup>
  <Target Name="RequireLocalPackageInputs" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(NativeAssetsRoot)' == '' Or !Exists('$(NativeAssetsRoot)/linux-x64/manifest.json') Or !Exists('$(NativeAssetsRoot)/win-x64/manifest.json')" Text="Use build_package.py with both verified native asset bundles." />
  </Target>
</Project>
