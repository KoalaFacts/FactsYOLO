<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- Exact SDK implementation; only the Native boundary is test controlled.
       This executable is separate from the installed-package consumer. -->
  <ItemGroup>
    <Compile Include="../../../sdk/dotnet/FactsYOLO/Result.cs" Link="Sdk/Result.cs" />
    <Compile Include="../../../sdk/dotnet/FactsYOLO/Handles.cs" Link="Sdk/Handles.cs" />
    <Compile Include="../../../sdk/dotnet/FactsYOLO/Diagnostics.cs" Link="Sdk/Diagnostics.cs" />
    <Compile Include="../../../sdk/dotnet/FactsYOLO/NativeTypes.cs" Link="Sdk/NativeTypes.cs" />
    <Compile Include="../../../sdk/dotnet/FactsYOLO/ApiTypes.cs" Link="Sdk/ApiTypes.cs" />
  </ItemGroup>
</Project>
